# Edusphere backend environment variables.
# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
#   Windows:  copy .env.template .env
#   macOS/Linux:  cp .env.template .env

# Which model writes the answers.
# Anything LiteLLM supports works: gemini/*, openai/*, anthropic/*, ollama/*.
# Use ollama/llama3 to run locally with no API key and no cost.
#
# NOTE: gemini-1.5-flash has been retired and now returns 404. Keep this current.
LITELLM_MODEL=gemini/gemini-2.5-flash

# Required for hosted models. A free Gemini key takes a minute and needs no card:
#   https://aistudio.google.com/apikey
# Without it the app still retrieves correctly, but every reply falls back to a
# raw snippet instead of a written answer.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Only needed if you point LITELLM_MODEL at an OpenAI model.
# OPENAI_API_KEY=

# Where the JSON store lives.
DB_PATH=./data
